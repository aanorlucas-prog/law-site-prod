---
import Layout from "../layouts/Layout.astro";
import FaqSection from "../components/FAQ.astro";
import Hero from "../components/Hero.astro";
import heroImage from "../assets/image2.jpg";
import { Phone, Mail, MapPin, Linkedin } from "lucide-astro";
const formId = "contact-form";
---

<Layout
  title="Contact | Maître Camille Herlido"
  description="Contactez Maître Camille Herlido, avocate en droit des affaires à Plérin. Prenez rendez-vous pour échanger sur votre problématique juridique."
>
  <!-- Hero -->
  <Hero
    title="Contact"
    description="Vous souhaitez être accompagné dans une problématique de droit des affaires ou obtenir un premier échange ?
    N'hésitez pas à prendre contact avec le cabinet."
    image={heroImage}
  />
  <!-- parlons -->
  <section class="bg-warm-2 py-20 lg:py-24">
    <div
      class="mx-auto flex max-w-4xl flex-col items-center px-6 text-center lg:px-8"
    >
      <h2 class="text-2xl font-semibold text-primary-700 lg:text-3xl">
        Parlons de votre situation
      </h2>

      <p class="mt-8 text-lg leading-8 text-primary-900">
        Chaque dossier est unique. Un premier échange permet de comprendre votre
        situation, d'identifier vos besoins et de vous orienter vers la solution
        la plus adaptée.
      </p>
    </div>
  </section>
  <!-- infos contact -->

  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2
        class="text-center text-2xl font-semibold text-primary-700 lg:text-3xl"
      >
        Les coordonnées du cabinet
      </h2>

      <div class="mt-14 flex flex-col gap-6 md:flex-row">
        <!-- Téléphone -->
        <article
          class="flex flex-1 flex-col items-center justify-center rounded-2xl bg-primary-50 p-8 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div class="flex items-center gap-3">
            <Phone class="h-6 w-6 text-primary-700" />
            <h3 class="text-lg font-semibold text-primary-800">Téléphone</h3>
          </div>
          <div class="flex flex-col items-center gap-2 mt-6">
            <a
              href="tel:+33631499846"
              class="text-primary-900 transition hover:text-primary-700 hover:underline underline-offset-4"
            >
              06&nbsp;31&nbsp;49&nbsp;98&nbsp;46
            </a>
            <a
              href="tel:+33257181005"
              class="text-primary-900 transition hover:text-primary-700 hover:underline underline-offset-4"
            >
              02&nbsp;57&nbsp;18&nbsp;10&nbsp;05
            </a>
          </div>
        </article>

        <!-- Email -->
        <article
          class="flex flex-1 flex-col items-center justify-center rounded-2xl bg-primary-100 p-8 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div class="flex items-center gap-3">
            <Mail class="h-6 w-6 text-primary-700" />
            <h3 class="text-lg font-semibold text-primary-800">Email</h3>
          </div>

          <a
            href="mailto:contact@herlido-avocat.fr"
            class="mt-6 break-all text-primary-900 transition hover:text-primary-700 hover:underline underline-offset-4"
          >
            contact@herlido-avocat.fr
          </a>
        </article>

        <!-- Adresse -->
        <article
          class="flex flex-1 flex-col items-center justify-center rounded-2xl bg-primary-200 p-8 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div class="flex items-center gap-3">
            <MapPin class="h-6 w-6 text-primary-700" />
            <h3 class="text-lg font-semibold text-primary-800">Cabinet</h3>
          </div>
          <a
            href="https://www.google.com/maps/search/?api=1&query=2+rue+François+Jacob+22190+Plérin"
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-pointer transition hover:text-primary-700 hover:underline underline-offset-4"
          >
            <address class="mt-6 not-italic text-primary-900">
              2 rue François Jacob<br />
              22190 Plérin
            </address>
          </a>
        </article>
      </div>

      <div class="mt-16 text-center">
        <p class="mb-6 text-primary-900">
          Vous souhaitez prendre rendez-vous directement ?
        </p>

        <a
          href="https://consultation.avocat.fr/avocat-plerin/camille-herlido-43060/prendre-rdv.html"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-72 items-center justify-center rounded-lg bg-primary-600 px-8 py-3 text-white transition hover:bg-primary-700"
        >
          Prendre rendez-vous via avocat.fr
        </a>
      </div>
    </div>
  </section>
  <!-- horaires -->
  <section
    class="bg-warm-2 flex flex-col items-center justify-center text-center p-16 gap-6"
  >
    <h2 class="text-primary-700 text-2xl mb-4">Horaires d’ouverture</h2>
    <div>
      <p class="text-primary-800">Lundi - Vendredi</p>
      <span class="text-primary-900">9h - 18h</span>
    </div>
    <div>
      <p class="text-primary-800">Samedi</p>
      <span class="text-primary-900">Sur demande</span>
    </div>
    <div>
      <p class="text-primary-800">Dimanche</p>
      <span class="text-primary-900">Fermé</span>
    </div>
  </section>
  <!-- accessibilité -->
  <section
    class="bg-white flex flex-col items-center justify-center text-center p-16 gap-6 mx-auto max-w-4xl"
  >
    <h2 class="text-primary-700 text-2xl">Accessibilité</h2>
    <p class="text-primary-900">
      Le cabinet est attentif à l'accueil de toutes les personnes. Si vous avez
      besoin d'un aménagement particulier lors de votre rendez-vous, n'hésitez
      pas à nous en informer en amont.
    </p>
  </section>
  <!-- Formulaire -->
  <section class="bg-warm-1 py-20 lg:py-24">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <h2 class="text-center text-3xl font-light text-primary-800 lg:text-4xl">
        Nous écrire
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-center text-primary-900">
        Décrivez brièvement votre situation. Le cabinet vous recontactera dans
        les meilleurs délais.
      </p>

      <form id={formId} class="mx-auto mt-12 w-full space-y-6">
        <!-- Nom -->
        <div>
          <label
            for="name"
            class="mb-2 block text-sm font-medium text-primary-900"
          >
            Nom et prénom *
          </label>

          <input
            id="name"
            name="name"
            aria-describedby="name-error"
            type="text"
            required
            autocomplete="name"
            aria-required="true"
            class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-primary-900 shadow-sm outline-none transition focus:border-primary-500 focus:ring-2 focus:ring-primary-300"
          />
          <p
            id="name-error"
            role="alert"
            class="hidden mt-2 rounded-lg bg-red-100 p-3 text-sm text-red-700"
          >
          </p>
        </div>

        <!-- Email -->
        <div>
          <label
            for="email"
            class="mb-2 block text-sm font-medium text-primary-900"
          >
            Adresse e-mail *
          </label>

          <input
            id="email"
            name="email"
            aria-describedby="email-error"
            type="email"
            required
            autocomplete="email"
            aria-required="true"
            class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-primary-900 shadow-sm outline-none transition focus:border-primary-500 focus:ring-2 focus:ring-primary-300"
          />
          <p
            id="email-error"
            role="alert"
            class="hidden mt-2 rounded-lg bg-red-100 p-3 text-sm text-red-700"
          >
          </p>
        </div>

        <!-- Téléphone -->
        <div>
          <label
            for="phone"
            class="mb-2 block text-sm font-medium text-primary-900"
          >
            Téléphone (facultatif)
          </label>

          <input
            id="phone"
            name="phone"
            aria-describedby="phone-error"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-primary-900 shadow-sm outline-none transition focus:border-primary-500 focus:ring-2 focus:ring-primary-300"
          />
          <p
            id="phone-error"
            role="alert"
            class="hidden mt-2 rounded-lg bg-red-100 p-3 text-sm text-red-700"
          >
          </p>
        </div>

        <!-- Objet -->
        <div>
          <label
            for="subject"
            class="mb-2 block text-sm font-medium text-primary-900"
          >
            Objet
          </label>

          <input
            id="subject"
            name="subject"
            aria-describedby="subject-error"
            type="text"
            autocomplete="off"
            class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-primary-900 shadow-sm outline-none transition focus:border-primary-500 focus:ring-2 focus:ring-primary-300"
          />
          <p
            id="subject-error"
            role="alert"
            class="hidden mt-2 rounded-lg bg-red-100 p-3 text-sm text-red-700"
          >
          </p>
        </div>

        <!-- Message -->
        <div>
          <label
            for="message"
            class="mb-2 block text-sm font-medium text-primary-900"
          >
            Votre message *
          </label>

          <textarea
            id="message"
            name="message"
            aria-describedby="message-error"
            required
            aria-required="true"
            rows="7"
            maxlength="3000"
            class="w-full resize-y rounded-lg border border-neutral-300 bg-white px-4 py-3 text-primary-900 shadow-sm outline-none transition focus:border-primary-500 focus:ring-2 focus:ring-primary-300"
          ></textarea>
          <p
            id="message-error"
            role="alert"
            class="hidden mt-2 rounded-lg bg-red-100 p-3 text-sm text-red-700"
          >
          </p>
        </div>

        <!-- Consentement -->
        <div class="flex items-start gap-3">
          <input
            id="consent"
            name="consent"
            required
            aria-describedby="consent-error"
            type="checkbox"
            class="mt-1 h-5 w-5 rounded border-neutral-300 text-primary-600 focus:border-primary-500 focus:ring-2 focus:ring-primary-300
transition"
          />

          <label for="consent" class="text-sm leading-6 text-primary-700">
            J'accepte que les informations saisies soient utilisées uniquement
            afin de répondre à ma demande, conformément à la politique de
            confidentialité.
          </label>
        </div>
        <p
          id="consent-error"
          role="alert"
          class="hidden mt-2 rounded-lg bg-red-100 p-3 text-sm text-red-700"
        >
        </p>

        <!-- Message retour -->
        <div id="form-message" class="hidden rounded-lg p-4 text-center"></div>

        <!-- Bouton -->
        <div class="pt-4 text-center">
          <button
            id="submit-button"
            type="submit"
            class="w-full rounded-lg bg-primary-600 px-8 py-3 font-medium text-white transition hover:bg-primary-700 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto cursor-pointer"
          >
            Envoyer ma demande
          </button>
        </div>

        <!-- RGPD -->
        <p
          class="mx-auto max-w-xl text-center text-xs leading-6 text-neutral-500"
        >
          Les informations transmises via ce formulaire sont utilisées
          exclusivement pour répondre à votre demande. Elles ne sont ni cédées
          ni vendues à des tiers.
        </p>
      </form>
    </div>
  </section>

  <FaqSection
    title="Questions fréquentes"
    items={[
      {
        question: "Sous quel délai recevrai-je une réponse ?",
        answer:
          "Le cabinet s'efforce de répondre aux demandes dans les meilleurs délais.",
      },
      {
        question: "Le premier échange est-il un engagement ?",
        answer:
          "Non. Il permet d'analyser votre situation et de déterminer les modalités d'un éventuel accompagnement.",
      },
      {
        question: "Puis-je prendre rendez-vous directement ?",
        answer:
          "Oui. Vous pouvez utiliser le lien vers  <a href='https://consultation.avocat.fr/avocat-plerin/camille-herlido-43060/prendre-rdv.html' target='_blank' rel='noopener noreferrer' class='text-primary-600 underline hover:text-primary-700'>avocat.fr</a> ou contacter directement le cabinet.",
      },
    ]}
  />
</Layout>
<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form");
    const formMessage = document.getElementById("form-message");
    const submitButton = document.getElementById("submit-button");

    if (!form || !formMessage) return;

    /*
    |--------------------------------------------------------------------------
    | Configuration des champs surveillés
    |--------------------------------------------------------------------------
   
    */

    const fields = {
      name: {
        element: document.getElementById("name"),
        error: document.getElementById("name-error"),
        message: "Veuillez renseigner votre nom et prénom.",
      },

      email: {
        element: document.getElementById("email"),
        error: document.getElementById("email-error"),
        message: "Veuillez renseigner une adresse e-mail valide.",
      },

      message: {
        element: document.getElementById("message"),
        error: document.getElementById("message-error"),
        message: "Veuillez renseigner votre message.",
      },

      consent: {
        element: document.getElementById("consent"),
        error: document.getElementById("consent-error"),
        message:
          "Vous devez accepter le traitement de vos données avant d'envoyer votre demande.",
      },
    };

    /*
    |--------------------------------------------------------------------------
    | Affichage d'une erreur sur un champ
    |--------------------------------------------------------------------------
    */

    function showFieldError(field, customMessage = null) {
      const { element, error, message } = field;

      if (!element || !error) return;

      error.textContent = customMessage ?? message;
      error.classList.remove("hidden");

      element.classList.add("border-red-400");
      element.classList.add("ring-2");
      element.classList.add("ring-red-200");
    }

    /*
    |--------------------------------------------------------------------------
    | Suppression d'une erreur sur un champ
    |--------------------------------------------------------------------------
    */

    function clearFieldError(field) {
      const { element, error } = field;

      if (!element || !error) return;

      error.textContent = "";
      error.classList.add("hidden");

      element.classList.remove("border-red-400");
      element.classList.remove("ring-2");
      element.classList.remove("ring-red-200");
    }

    /*
    |--------------------------------------------------------------------------
    | Gestion des erreurs natives HTML5
    |--------------------------------------------------------------------------
    */

    form.addEventListener(
      "invalid",
      (event) => {
        event.preventDefault();

        const field = event.target;

        const config = Object.values(fields).find(
          (item) => item.element === field,
        );

        if (!config) return;

        showFieldError(config);
      },
      true,
    );

    /*
    |--------------------------------------------------------------------------
    | Suppression automatique de l'erreur
    |--------------------------------------------------------------------------
    */

    Object.values(fields).forEach((field) => {
      const { element } = field;

      if (!element) return;

      element.addEventListener("input", () => {
        clearFieldError(field);
      });

      element.addEventListener("change", () => {
        clearFieldError(field);
      });
    });

    /*
    |--------------------------------------------------------------------------
    | fonction pour désactiver/activer bouton
    |--------------------------------------------------------------------------
    */

    function setLoading(isLoading) {
      if (!submitButton) return;

      submitButton.disabled = isLoading;

      submitButton.textContent = isLoading
        ? "Envoi en cours..."
        : "Envoyer ma demande";
    }

    /*
    |--------------------------------------------------------------------------
    | Envoi du formulaire
    |--------------------------------------------------------------------------
    */

    form.addEventListener("submit", async (event) => {
      /*
      | Sécurité :
      | on laisse HTML5 vérifier les required avant l'envoi
      */

      if (!form.checkValidity()) {
        event.preventDefault();
        return;
      }

      event.preventDefault();

      clearFormErrors();
      setLoading(true);

      const formData = new FormData(form);

      const data = {
        name: formData.get("name"),
        email: formData.get("email"),
        phone: formData.get("phone"),
        subject: formData.get("subject"),
        message: formData.get("message"),

        // Une checkbox renvoie "on" si cochée
        consent: formData.get("consent") === "on",
      };

      try {
        const response = await fetch("/api/contact", {
          method: "POST",

          headers: {
            "Content-Type": "application/json",
          },

          body: JSON.stringify(data),
        });

        const result = await response.json();

        /*
        | Erreurs venant de Zod
        */

        if (!response.ok) {
          if (result.errors) {
            displayErrors(result.errors);
            setLoading(false);
            return;
          }

          showMessage(result.error ?? "Une erreur est survenue.", false);
          setLoading(false);
          return;
        }

        /*
        | Succès
        */

        showMessage(
          "Votre demande a bien été envoyée. Le cabinet vous répondra dans les meilleurs délais.",
          true,
        );
        setLoading(false);
        form.reset();
      } catch (error) {
        setLoading(false);
        showMessage(
          "Impossible d'envoyer votre demande actuellement. Veuillez réessayer plus tard.",
          false,
        );
      }
    });

    /*
    |--------------------------------------------------------------------------
    | Affichage des erreurs Zod
    |--------------------------------------------------------------------------
    */

    function displayErrors(errors) {
      Object.entries(errors).forEach(([field, messages]) => {
        // Récupération du message d'erreur
        const errorElement = document.getElementById(`${field}-error`);

        // Récupération de l'input concerné
        const inputElement = document.getElementById(field);

        if (!errorElement) {
          console.warn(`Pas d'élément erreur trouvé pour ${field}`);
          return;
        }

        // Affichage du message
        errorElement.textContent = messages[0];
        errorElement.classList.remove("hidden");

        // Ajout du style erreur sur le champ
        if (inputElement) {
          inputElement.classList.add(
            "border-red-400",
            "ring-2",
            "ring-red-200",
          );
        }
      });
    }

    /*
    |--------------------------------------------------------------------------
    | Nettoyage complet des erreurs
    |--------------------------------------------------------------------------
    */

    function clearFormErrors() {
      Object.values(fields).forEach((field) => {
        clearFieldError(field);
      });

      formMessage.classList.add("hidden");
      formMessage.textContent = "";
    }

    /*
    |--------------------------------------------------------------------------
    | Message global succès / erreur
    |--------------------------------------------------------------------------
    */

    function showMessage(text, success) {
      formMessage.classList.remove("hidden");

      if (success) {
        formMessage.className =
          "rounded-lg bg-green-100 p-4 text-center text-green-700";
      } else {
        formMessage.className =
          "rounded-lg bg-red-100 p-4 text-center text-red-700";
      }

      formMessage.textContent = text;
    }
  });
</script>
