---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import heroImage from "../assets/image2.jpg";
import CardGroup from "../components/CardGroup.astro";

const steps = [
  {
    title: "Contentieux commerciaux et contractuels",
    text: "Rupture de relations commerciales, inexécution contractuelle, concurrence déloyale, recouvrement complexe et responsabilité contractuelle.",
  },
  {
    title: "Baux commerciaux et actifs stratégiques",
    text: "Loyers commerciaux, renouvellement, résiliation, indemnité d'éviction, charges et travaux incombant aux parties.",
  },
  {
    title: "Conflits entre associés et gouvernance",
    text: "Blocages sociétaires, révocation de dirigeants, responsabilité des associés et des mandataires sociaux, garantie d’actif et de passif",
  },
  {
    title: "Voies d’exécution",
    text: "Mesures conservatoires, saisies mobilières, saisies immobilières",
  },
  {
    title: "Entreprises en difficultés",
    text: "Prévention des difficultés, procédures collectives, défense des créanciers, restructuration et traitement du passif",
  },
  {
    title: "Contentieux bancaire et garanties",
    text: "Cautionnements, sûretés, responsabilités bancaires, mesures d'exécution et contentieux du financement.",
  },
];
---

<Layout
  title="Domaines d'expertise | Maître Camille Herlido – Avocate en droit des affaires"
>
  <!-- Hero -->
  <Hero
    title="Mes domaines d'expertise"
    description="J'accompagne les entreprises et leurs dirigeants dans leurs problématiques de droit des affaires, tant en conseil qu'en contentieux."
    image={heroImage}
  />
  <!-- Domaines d'expertise -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2
        class="text-center text-2xl font-semibold text-primary-700 lg:text-3xl"
      >
        Les domaines d'intervention du cabinet
      </h2>

      <div class="mt-12">
        <CardGroup
          items={steps}
          layoutClass="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3"
        />
      </div>
    </div>
  </section>
  <!-- CTA -->
  <section class="bg-warm-2 py-20 lg:py-24">
    <div
      class="mx-auto flex max-w-3xl flex-col items-center px-6 text-center lg:px-8"
    >
      <h2 class="text-2xl font-semibold text-primary-700 lg:text-3xl">
        Vous vous interrogez sur votre situation&nbsp;?
      </h2>

      <p class="mt-6 text-lg leading-8 text-primary-900">
        Chaque dossier est unique. Échangeons afin d'identifier les solutions
        adaptées à vos besoins.
      </p>

      <a
        href="/contact"
        class="mt-10 w-full rounded-lg bg-primary-600 px-8 py-3 text-center text-white transition hover:bg-primary-700 sm:w-56"
      >
        Prendre contact
      </a>
    </div>
  </section>
</Layout>
