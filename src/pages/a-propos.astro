---
import Layout from "../layouts/Layout.astro";
import CardGroup from "../components/CardGroup.astro";
import photo from "../assets/camille.jpg";
const values = [
  {
    title: "Écoute",
    text: "Chaque situation est unique et mérite une attention particulière.",
  },
  {
    title: "Rigueur",
    text: "Une analyse juridique approfondie pour sécuriser les décisions.",
  },
  {
    title: "Réactivité",
    text: "Répondre rapidement aux enjeux des entreprises.",
  },
  {
    title: "Confidentialité",
    text: "Garantir la discrétion indispensable à la relation de confiance.",
  },
];
---

<Layout
  title="A Propos | Maître Camille Herlido"
  description="Découvrez le parcours et l'approche de Maître Camille Herlido, avocate en droit des affaires à Plérin, accompagnant entreprises et dirigeants dans leurs enjeux juridiques."
>
  <!-- Hero -->
  <section class="bg-primary-200 py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h1 class="text-3xl font-light text-primary-800 lg:text-5xl">À Propos</h1>
      <h2 class="mt-6 text-xl text-primary-700 lg:text-2xl">
        Une approche stratégique du droit des affaires au service des
        entreprises.
      </h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-primary-900">
        J'accompagne les dirigeants et les entreprises dans la prévention des
        risques, la résolution des litiges et la sécurisation de leurs
        décisions.
      </p>
    </div>
  </section>
  <!-- Photo -->
  <section class="bg-white py-20 lg:py-24">
    <div
      class="mx-auto flex max-w-7xl flex-col-reverse items-center text-center gap-12 px-6 lg:flex-row lg:gap-20 lg:px-8"
    >
      <!-- Texte -->
      <div class="max-w-2xl space-y-6">
        <h2 class="text-3xl font-light text-primary-700 lg:text-4xl pb-16">
          Maître Camille Herlido
        </h2>

        <p class="text-xl text-primary-800">
          Avocate au Barreau de Saint-Brieuc, j'exerce exclusivement en droit
          des affaires.
        </p>

        <p class="leading-8 text-primary-900">
          J'accompagne les entreprises et leurs dirigeants dans la gestion de
          leurs problématiques juridiques, qu'il s'agisse de prévention des
          risques, de contentieux ou d'accompagnement stratégique.
        </p>
      </div>

      <!-- Photo -->
      <div class="shrink-0">
        <img
          src={photo.src}
          alt="Portrait de Maître Camille Herlido, avocate en droit des affaires"
          class="w-64 rounded-2xl object-cover shadow-lg sm:w-80 lg:w-[420px] xl:w-[500px]"
        />
      </div>
    </div>
  </section>

  <!-- parcours -->
  <section class="bg-warm-3 py-20 lg:py-24">
    <div
      class="mx-auto max-w-4xl px-6 lg:px-8 flex flex-col items-center text-center"
    >
      <h2
        class="text-center text-2xl font-semibold text-primary-700 lg:text-3xl"
      >
        Un parcours dédié au droit des affaires
      </h2>

      <div class="mt-10 space-y-6 text-lg leading-8 text-primary-900">
        <p>
          Titulaire d'un Master 1 en droit des affaires et d'un Master 2 en
          droit privé général, parcours droit des affaires, j'ai exercé pendant
          plus de sept années au sein de cabinets spécialisés en droit des
          affaires, en conseil comme en contentieux.
        </p>

        <p>
          Cette expérience m'a permis d'accompagner des entreprises confrontées
          à des problématiques variées et d'acquérir une vision globale des
          enjeux auxquels elles sont confrontées.
        </p>
      </div>
    </div>
  </section>

  <!-- valeurs -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-20 lg:px-24">
      <h2
        class="mb-12 text-center text-3xl font-light text-primary-700 lg:text-3xl"
      >
        Les valeurs du cabinet
      </h2>

      <CardGroup items={values} />
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-warm-2 py-20 lg:py-24">
    <div
      class="mx-auto flex max-w-3xl flex-col items-center px-6 text-center lg:px-8"
    >
      <h2 class="text-2xl font-light text-primary-800 lg:text-3xl">
        Un accompagnement adapté à votre situation
      </h2>

      <div class="mt-8 space-y-6 text-lg leading-8 text-primary-900">
        <p>
          Chaque entreprise et chaque dirigeant sont confrontés à des enjeux qui
          leur sont propres.
        </p>

        <p>
          C'est pourquoi chaque accompagnement est construit de manière
          personnalisée, en tenant compte des objectifs, des contraintes et des
          enjeux propres à chaque situation.
        </p>
      </div>

      <a
        href="/contact"
        class="mt-10 w-full rounded-lg bg-primary-600 px-8 py-3 text-center text-white transition hover:bg-primary-700 sm:w-56"
      >
        Prendre contact
      </a>
    </div>
  </section>
</Layout>
