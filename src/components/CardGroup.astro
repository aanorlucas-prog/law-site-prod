---
import Card from "./Card.astro";

interface Step {
  title: string;
  text: string;
}

interface Props {
  items: Step[];
}

const { items } = Astro.props;

const themes = [
  {
    bg: "bg-primary-100",
    title: "text-primary-900",
    text: "text-primary-700",
  },
  {
    bg: "bg-primary-200",
    title: "text-primary-900",
    text: "text-primary-700",
  },
  {
    bg: "bg-primary-300",
    title: "text-primary-900",
    text: "text-primary-800",
  },
  {
    bg: "bg-primary-400",
    title: "text-primary-900",
    text: "text-primary-800",
  },
  {
    bg: "bg-primary-500",
    title: "text-primary-200",
    text: "text-primary-50",
  },
  {
    bg: "bg-primary-600",
    title: "text-primary-200",
    text: "text-primary-50",
  },
];
---

<div class="flex flex-col gap-6 lg:flex-row">
  {
    items.map((item, index) => {
      const theme = themes[Math.min(index, themes.length - 1)];

      return (
        <Card
          title={item.title}
          text={item.text}
          bgClass={theme.bg}
          titleClass={theme.title}
          textClass={theme.text}
        />
      );
    })
  }
</div>
