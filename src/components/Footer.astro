---
const navigation = [
  { label: "Accueil", href: "/" },
  { label: "À Propos", href: "/a-propos" },
  { label: "Domaines d'Intervention", href: "/domaines-expertise" },
  { label: "Honoraires", href: "/honoraires" },
  { label: "Contact", href: "/contact" },
];

import { Phone, Mail, MapPin, Linkedin } from "lucide-astro";
import logo from "../assets/logo-3.png";
---

<footer class="bg-primary-900 text-white">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <!-- Partie haute -->
    <div
      class="grid
        grid-cols-1
        gap-10
        md:grid-cols-2
        lg:grid-cols-4
        lg:items-center"
    >
      <!-- Logo -->
      <div class="flex flex-col items-center lg:items-start">
        <img
          src={logo.src}
          alt="Maître Camille Herlido"
          width={logo.width}
          height={logo.height}
          class="h-32 w-auto"
        />
      </div>

      <!-- Cabinet -->
      <div class="text-center lg:text-left">
        <h3 class="text-lg font-semibold">Maître Camille HERLIDO</h3>

        <p class="mt-3 text-primary-200">Avocate en droit des affaires</p>

        <p class="text-primary-200">Barreau de Saint-Brieuc</p>
      </div>

      <!-- Navigation -->
      <div class="text-center lg:text-left">
        <h3
          class="mb-5 font-semibold underline decoration-primary-400 underline-offset-4"
        >
          Navigation
        </h3>

        <ul class="space-y-3">
          {
            navigation.map((link) => (
              <li>
                <a href={link.href} class="transition hover:text-primary-400">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div class="text-center lg:text-left">
        <h3
          class="mb-5 font-semibold underline decoration-primary-400 underline-offset-4"
        >
          Contact
        </h3>

        <div class="space-y-4">
          <div class="flex items-center justify-center gap-3 lg:justify-start">
            <Phone class="h-5 w-5 text-primary-400" />

            <a href="tel:0631499846"> 06&nbsp;31&nbsp;49&nbsp;98&nbsp;46 </a>
          </div>

          <div class="flex items-center justify-center gap-3 lg:justify-start">
            <Mail class="h-5 w-5 text-primary-400" />

            <a href="mailto:contact@herlido-avocat.fr">
              contact@herlido-avocat.fr
            </a>
          </div>

          <div class="flex items-start justify-center gap-3 lg:justify-start">
            <MapPin class="mt-1 h-5 w-5 text-primary-400" />
            <a
              href="https://www.google.com/maps/search/?api=1&query=2+rue+François+Jacob+22190+Plérin"
              target="_blank"
              rel="noopener noreferrer"
              class="cursor-pointer transition hover:text-primary-700 hover:underline underline-offset-4"
            >
              <address class="not-italic">
                2 rue François Jacob<br />
                22190 PLERIN
              </address>
            </a>
          </div>

          <div class="flex items-center justify-center gap-3 lg:justify-start">
            <Linkedin class="h-5 w-5 text-primary-400" />

            <a
              href="https://www.linkedin.com/in/camille-herlido-a09b3986"
              target="_blank"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->

    <section
      class="mt-16
        rounded-3xl
       
        px-8
        py-10
        text-center"
    >
      <h3 class="text-lg font-semibold">Vous avez une question juridique ?</h3>

      <div
        class="mt-8
          flex
          flex-col
          items-center
          justify-center
          gap-4
          sm:flex-row"
      >
        <a
          href="/contact"
          class="w-56
          text-center
          rounded-full
            bg-primary-400
            px-8
            py-3
            font-medium
            text-primary-900
            transition
            hover:bg-white"
        >
          Me contacter
        </a>

        <a
          href="https://consultation.avocat.fr/avocat-plerin/camille-herlido-43060/prendre-rdv.html"
          target="_blank"
          rel="noopener noreferrer"
          class="w-56
          text-center
          rounded-full
            border
            border-primary-300
            px-8
            py-3
            font-medium
            transition
            hover:bg-primary-700"
        >
          Prendre rendez-vous
        </a>
      </div>
    </section>

    <!-- Bas -->

    <div
      class="mt-12
        flex
        flex-col
        items-center
        justify-center
        gap-4
        border-t
        border-primary-700
        pt-6
        text-sm
        text-primary-300"
    >
      <p>© 2026 HERLIDO Camille — Tous droits réservés</p>

      <a href="/mentions-legales" class="transition hover:text-white">
        Mentions légales
      </a>
    </div>
  </div>
</footer>
