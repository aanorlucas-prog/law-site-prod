---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="px-6
    py-12
    md:px-10
    md:py-16">
  <div
    class="mx-auto
      max-w-4xl
      rounded-xl
      bg-white
      px-6
      py-12
      text-center"
  >
    <h2 class="mb-6
        text-3xl
        font-light
        text-primary-900">
      {title}
    </h2>

    <p
      class="mx-auto
        mb-10
        max-w-2xl
        text-lg
        text-neutral-700"
    >
      {description}
    </p>

    <div
      class="flex
        flex-col
        items-center
        gap-4
        md:flex-row
        md:justify-center"
    >
      <a
        href="/contact"
        class="w-56
          text-center
        rounded-lg
          bg-primary-600
          px-8
          py-3
          text-white
          transition
          hover:bg-primary-700"
      >
        Me contacter
      </a>

      <a
        href="/contact"
        class="w-56
          text-center
        rounded-lg
          border
          border-primary-600
          px-8
          py-3
          text-primary-600
          transition
          hover:bg-primary-50"
      >
        Prendre rendez-vous
      </a>
    </div>
  </div>
</section>
